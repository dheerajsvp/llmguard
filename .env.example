# Copy to .env and fill in EVERY blank. Never commit .env.
# Generate a secret with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Postgres password (use letters and digits only: it is placed inside a URL).
POSTGRES_PASSWORD=

# Keys that may call POST /v1/chat. Comma-separated, each at least 16 characters.
LLMGUARD_API_KEYS=
# Keys that may call the read API / dashboard. Must differ from the chat keys.
LLMGUARD_ADMIN_KEYS=

# "fake" = canned demo replies, no Gemini key needed. Use "gemini" for the real model.
LLMGUARD_PROVIDER=fake
GEMINI_API_KEY=

# Placeholder types that may be restored in replies, e.g. PHONE,EMAIL. Empty = restore nothing.
LLMGUARD_RESTORE_TYPES=

# Host ports (bound to 127.0.0.1 only). The dashboard is at http://127.0.0.1:8088 by default.
API_PORT=8000
DASHBOARD_PORT=8088
